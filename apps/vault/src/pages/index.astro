---
import { getCollection } from "astro:content"
import VaultLayout from "../layouts/VaultLayout.astro"

const allDocs = await getCollection("vault")

const grouped: Record<string, typeof allDocs> = {}
for (const doc of allDocs) {
  const category = doc.id.includes("/") ? doc.id.split("/")[0] : "uncategorized"
  if (!grouped[category]) grouped[category] = []
  grouped[category].push(doc)
}

const sortedCategories = Object.keys(grouped).sort()
for (const cat of sortedCategories) {
  grouped[cat].sort((a, b) => a.data.title.localeCompare(b.data.title))
}

function kebabToTitle(s: string): string {
  return s.split("-").map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(" ")
}

function getWordCount(body: string | undefined): number {
  return body ? body.split(/\s+/).filter(Boolean).length : 0
}

function getReadingTime(words: number): number {
  return Math.max(1, Math.ceil(words / 200))
}

const totalDocs = allDocs.length
const totalWords = allDocs.reduce((sum, doc) => sum + getWordCount(doc.body), 0)

---

<VaultLayout title="Index">
  <header class="vault-fade mb-16" style="--i:0">
    <p class="label-xs text-brand">Personal knowledge base</p>
    <h1 class="mt-4 font-display text-[clamp(2.6rem,8vw,4.75rem)] font-semibold leading-[0.95] tracking-[-0.045em] [font-variation-settings:'wdth'_92]">
      Notes worth<br />keeping close.
    </h1>
    <p class="mt-6 max-w-md text-dim">Roadmaps, interview prep, and project notes.</p>

    <div class="mt-6 flex flex-wrap gap-2 text-xs">
      <span class="rounded-full bg-brand-wash px-2.5 py-1 text-brand">
        {totalDocs} documents
      </span>
      <span class="rounded-full border border-line px-2.5 py-1 text-dim">
        {totalWords.toLocaleString()} words
      </span>
      <span class="rounded-full border border-line px-2.5 py-1 text-dim">
        {sortedCategories.length} categories
      </span>
    </div>
  </header>

  <!-- Categories -->
  {sortedCategories.map((category, catIdx) => (
    <section class="vault-fade mb-14" style={`--i:${catIdx + 1}`}>
      <header class="mb-3 flex items-baseline justify-between gap-5 border-b border-line pb-4">
        <h2 class="font-display text-[clamp(1.15rem,1.9vw,1.4rem)] font-semibold tracking-[-0.02em] [font-variation-settings:'wdth'_94]">
          {kebabToTitle(category)}
        </h2>
        <span class="label-xs text-faint">{grouped[category].length} entries</span>
      </header>

      <div>
        {grouped[category].map((doc) => {
          const slug = doc.id.includes("/") ? doc.id.split("/").slice(1).join("/") : doc.id
          const words = getWordCount(doc.body)
          const time = getReadingTime(words)
          return (
            <a
              href={`/${category}/${slug}`}
              class="vault-entry group"
            >
              <div class="flex items-center justify-between gap-4 border-b border-line py-4">
                <span class="min-w-0 truncate font-display text-[1.05rem] font-medium tracking-[-0.015em] transition-colors duration-[380ms] group-hover:text-brand">
                  {doc.data.title}
                </span>
                <div class="flex shrink-0 items-center gap-2 text-xs tabular-nums text-faint">
                  <span>{words.toLocaleString()} w</span>
                  <span aria-hidden="true">·</span>
                  <span>{time} min</span>
                  <span class="ml-1 text-brand opacity-0 transition-opacity duration-[380ms] group-hover:opacity-100" aria-hidden="true">→</span>
                </div>
              </div>
            </a>
          )
        })}
      </div>
    </section>
  ))}
</VaultLayout>

<style>
  .vault-entry {
    display: block;
    transition: padding-left 500ms var(--ease-brand);
  }

  .vault-entry:hover {
    padding-left: 0.625rem;
  }

  .vault-entry:active {
    opacity: 0.7;
  }

  .vault-fade {
    animation: vaultFadeIn 600ms var(--ease-brand) both;
    animation-delay: calc(var(--i, 0) * 80ms);
  }

  @keyframes vaultFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
