---
import "../styles/fonts.css"
import "../styles/global.css"

interface Props {
  title: string
}

const { title } = Astro.props
const portfolioUrl = "https://purbayan.me"
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Vault</title>
  </head>
  <body class="min-h-dvh bg-ground text-ink">
    <header class="border-b border-line px-6 py-5 md:px-8">
      <div class="mx-auto flex max-w-3xl items-center justify-between">
        <a
          href="/"
          class="font-display text-lg font-semibold tracking-[-0.02em] transition-colors duration-[380ms] hover:text-brand"
        >
          Vault
        </a>
        <a
          href={portfolioUrl}
          class="label-xs text-dim transition-colors duration-[380ms] hover:text-brand"
        >
          ← portfolio
        </a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-6 py-12 md:px-8 md:py-20">
      <slot />
    </main>
  </body>
</html>
