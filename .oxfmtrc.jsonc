{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "tabWidth": 2,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "apps/*/dist",
    "apps/*/node_modules",
    "apps/vault/.astro",
  ],
}
